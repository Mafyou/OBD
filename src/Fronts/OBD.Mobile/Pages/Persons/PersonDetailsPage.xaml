<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OBD.Mobile.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:strings="clr-namespace:OBD.Mobile.Lib.Resources.Strings;assembly=OBD.Mobile.Lib"
             x:Class="OBD.Mobile.Pages.Persons.PersonDetailsPage"
             x:DataType="vm:PersonDetailsViewModel"
             Title="{Binding PageTitle}"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundPrimary}">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">

            <!-- Avertissement si aucun secteur -->
            <Border IsVisible="{Binding HasNoSectors}"
                    BackgroundColor="{StaticResource WarningBackground}"
                    Stroke="{StaticResource WarningColor}"
                    StrokeThickness="1"
                    Padding="12">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{strings:Translate PersonDetails_NoSectorTitle}"
                           FontFamily="GeistSemiBold"
                           FontSize="14"
                           TextColor="{StaticResource WarningColor}" />
                    <Label Text="{strings:Translate PersonDetails_NoSectorMessage}"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                    <Button Text="{strings:Translate PersonDetails_GoToParameters}"
                            Clicked="OnGoToParametersClicked"
                            BackgroundColor="{StaticResource WarningColor}"
                            TextColor="{StaticResource WarningOnColor}"
                            CornerRadius="8"
                            FontSize="13"
                            HeightRequest="36"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource BackgroundSurface}"
                    StrokeThickness="0" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Entry Placeholder="{strings:Translate PersonDetails_NamePlaceholder}"

                       Text="{Binding Person.Name}"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       BackgroundColor="Transparent" />
            </Border>

            <Border BackgroundColor="{StaticResource BackgroundSurface}"
                    StrokeThickness="0" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Entry Placeholder="{strings:Translate PersonDetails_PositionPlaceholder}"

                       Text="{Binding Person.Position}"
                       TextColor="{StaticResource TextPrimary}"
                       PlaceholderColor="{StaticResource TextSecondary}"
                       BackgroundColor="Transparent" />
            </Border>

            <Border BackgroundColor="{StaticResource BackgroundSurface}"
                    StrokeThickness="0" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Picker Title="{strings:Translate PersonDetails_SectorPickerTitle}"
                        ItemsSource="{Binding Sectors}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedSector}"
                        TextColor="{StaticResource TextPrimary}"
                        TitleColor="{StaticResource TextSecondary}"
                        BackgroundColor="Transparent" />
            </Border>

            <Border BackgroundColor="{StaticResource BackgroundSurface}"
                    StrokeThickness="0" Padding="4">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Editor Placeholder="{strings:Translate PersonDetails_MemoPlaceholder}"
                        Text="{Binding Person.Memo}"
                        TextColor="{StaticResource TextPrimary}"
                        PlaceholderColor="{StaticResource TextSecondary}"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="80" />
            </Border>

            <Button Text="{strings:Translate Common_Save}"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource AccentPrimary}"
                    TextColor="{StaticResource BackgroundPrimary}"
                    CornerRadius="12"
                    Margin="0,8,0,0" />

            <Button Text="{strings:Translate Common_Delete}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsNew, Converter={StaticResource InvertedBool}}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource DangerColor}"
                    CornerRadius="12" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
