<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OBD.Mobile.ViewModels"
             xmlns:model="clr-namespace:OBD.Mobile.Lib.Models;assembly=OBD.Mobile.Lib"
             xmlns:strings="clr-namespace:OBD.Mobile.Lib.Resources.Strings;assembly=OBD.Mobile.Lib"
             x:Class="OBD.Mobile.Pages.Parameters.ParametersPage"
             x:DataType="vm:ParametersViewModel"
             Title="{strings:Translate Shell_Parameters}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundPrimary}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource AccentDark}"
              ColumnDefinitions="*,Auto"
              Padding="16,12,8,12">
            <Label Grid.Column="0"
                   Text="{strings:Translate Shell_Parameters}"
                   FontFamily="GeistSemiBold"
                   FontSize="20"
                   TextColor="{StaticResource TextPrimary}"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="&#xE8B6;"
                    FontFamily="MaterialSymbols"
                    Clicked="OnSearchClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextPrimary}"
                    FontSize="22"
                    Padding="8,0"
                    HeightRequest="44" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Work habits -->
                <Label Text="{strings:Translate Parameters_WorkHabits}"
                       FontFamily="GeistSemiBold"
                       FontSize="18"
                       TextColor="{StaticResource TextPrimary}" />

                <Border BackgroundColor="{StaticResource BackgroundSurface}"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Entry Placeholder="{strings:Translate Parameters_RegularMeetingsPlaceholder}"

                               Text="{Binding WorkHabits.RegularMeetings}"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               BackgroundColor="Transparent" />
                        <Entry Placeholder="{strings:Translate Parameters_RemoteDaysPlaceholder}"

                               Text="{Binding WorkHabits.RemoteWorkDays}"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               BackgroundColor="Transparent" />
                        <Picker Title="{strings:Translate Parameters_ManagerPickerTitle}"
                                ItemsSource="{Binding Persons}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedManager}"
                                TextColor="{StaticResource TextPrimary}"
                                TitleColor="{StaticResource TextSecondary}"
                                BackgroundColor="Transparent" />
                        <Button Text="{strings:Translate Common_Save}"
                                Command="{Binding SaveWorkHabitsCommand}"
                                BackgroundColor="{StaticResource AccentPrimary}"
                                TextColor="{StaticResource BackgroundPrimary}"
                                CornerRadius="8" />
                    </VerticalStackLayout>
                </Border>

                <!-- Language -->
                <Label Text="{strings:Translate Parameters_Language}"
                       FontFamily="GeistSemiBold"
                       FontSize="18"
                       TextColor="{StaticResource TextPrimary}"
                       Margin="0,8,0,0" />

                <Border BackgroundColor="{StaticResource BackgroundSurface}"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Picker ItemsSource="{Binding AvailableLanguages}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedLanguage}"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="Transparent" />
                </Border>

                <!-- Sectors -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <Label Text="{strings:Translate Parameters_Sectors}"
                           FontFamily="GeistSemiBold"
                           FontSize="18"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="&#xE145;"
                            FontFamily="MaterialSymbols"
                            Command="{Binding OpenSectorDetailCommand}"
                            BackgroundColor="{StaticResource AccentPrimary}"
                            TextColor="{StaticResource BackgroundPrimary}"
                            WidthRequest="36"
                            HeightRequest="36"
                            CornerRadius="18"
                            FontSize="20"
                            Padding="0" />
                </Grid>

                <!-- A plain layout, not a CollectionView: inside this ScrollView its height is unbounded, and its
                     empty view then asked for a new layout on every frame for as long as it was shown -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sectors}">
                    <BindableLayout.EmptyView>
                        <Label Text="{strings:Translate Parameters_NoSector}"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,4" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="model:Sector">
                            <Border Margin="0,4"
                                    BackgroundColor="{StaticResource BackgroundSurface}"
                                    StrokeThickness="0"
                                    Padding="16,12">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ParametersViewModel}}, Path=OpenSectorDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       TextColor="{StaticResource TextPrimary}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- À propos -->
                <Label Text="{strings:Translate Parameters_About}"
                       FontFamily="GeistSemiBold"
                       FontSize="18"
                       TextColor="{StaticResource TextPrimary}"
                       Margin="0,8,0,0" />

                <Border BackgroundColor="{StaticResource BackgroundSurface}"
                        StrokeThickness="0" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">

                        <Label TextColor="{StaticResource TextSecondary}"
                               FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{strings:Translate Parameters_CreatedByPrefix}" />
                                    <Span Text="Mafyou"
                                          FontFamily="GeistSemiBold"
                                          TextColor="{StaticResource TextPrimary}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BackgroundPrimary}"
                                 Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{strings:Translate Parameters_PrivacyPolicy}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5C8;"
                                   FontFamily="MaterialSymbols"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BackgroundPrimary}"
                                 Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRepoClicked" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{strings:Translate Parameters_SourceCode}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="14" />
                                <Label Text="{strings:Translate Parameters_OpenSourceGithub}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="&#xE5C8;"
                                   FontFamily="MaterialSymbols"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BackgroundPrimary}"
                                 Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPromoPageClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{strings:Translate Parameters_PromoPage}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5C8;"
                                   FontFamily="MaterialSymbols"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource BackgroundPrimary}"
                                 Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGetHelpClicked" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{strings:Translate Parameters_GetHelp}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="&#xE5C8;"
                                   FontFamily="MaterialSymbols"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="18"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
