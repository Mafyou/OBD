<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OBD.Mobile.ViewModels"
             xmlns:strings="clr-namespace:OBD.Mobile.Lib.Resources.Strings;assembly=OBD.Mobile.Lib"
             x:Class="OBD.Mobile.Pages.Onboarding.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             BackgroundColor="{StaticResource BackgroundPrimary}"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto,*" Padding="32">

        <!-- Logo + titre -->
        <VerticalStackLayout Grid.Row="1" Spacing="32" VerticalOptions="Center">

            <Image Source="logo.png"
                   HeightRequest="80"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="{strings:Translate Onboarding_Welcome}"
                   FontSize="26"
                   FontFamily="GeistSemiBold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="{strings:Translate Onboarding_HowStart}"
                   FontSize="15"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Choix pré-rempli -->
            <Border BackgroundColor="{StaticResource BackgroundSurface}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChoosePrefilledCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{strings:Translate Onboarding_PrefilledTitle}"
                           FontSize="16"
                           FontFamily="GeistSemiBold"
                           TextColor="{StaticResource AccentPrimary}" />
                    <Label Text="{strings:Translate Onboarding_PrefilledDesc}"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Choix vide -->
            <Border BackgroundColor="{StaticResource BackgroundSurface}"
                    StrokeShape="RoundRectangle 12"
                    Padding="20,16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChooseEmptyCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="{strings:Translate Onboarding_EmptyTitle}"
                           FontSize="16"
                           FontFamily="GeistSemiBold"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="{strings:Translate Onboarding_EmptyDesc}"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </Grid>

</ContentPage>