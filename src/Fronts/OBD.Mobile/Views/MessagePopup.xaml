<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               BackgroundColor="Transparent"
               x:Class="OBD.Mobile.Views.MessagePopup">

    <Border Style="{StaticResource DialogSurface}">
        <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
        <VerticalStackLayout Spacing="20" Padding="28,24" MinimumWidthRequest="300">

            <Label x:Name="TitleLabel" Style="{StaticResource DialogTitle}" />

            <!-- A long message scrolls, the button stays in view: on a short window (the outer screen of a foldable,
                 410 units tall) it pushed the button below the bottom edge (MessagePopup.xaml.cs) -->
            <ScrollView x:Name="MessageScroll">
                <Label x:Name="MessageLabel" Style="{StaticResource DialogMessage}" />
            </ScrollView>

            <Button x:Name="AcceptButton"
                    Style="{StaticResource DialogPrimaryButton}"
                    Clicked="OnAcceptClicked"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>
    </Border>

</toolkit:Popup>
